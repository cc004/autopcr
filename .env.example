# AutoPCR Docker Configuration
# Copy this file to .env and modify as needed
# cp .env.example .env

# ---- Server Settings ----

# HTTP server bind address (0.0.0.0 = all interfaces)
AUTOPCR_SERVER_HOST=0.0.0.0

# HTTP server port
AUTOPCR_SERVER_PORT=13200

# Enable debug logging (true/false)
AUTOPCR_SERVER_DEBUG_LOG=false

# Allow new user registration (true/false)
AUTOPCR_SERVER_ALLOW_REGISTER=true

# Superuser QQ number (has admin privileges, leave empty to disable)
AUTOPCR_SERVER_SUPERUSER=

# ---- Public Access (for QQ bot message links) ----

# Public IP or domain for QQ bot to send access links
# e.g., "example.com" or "1.2.3.4:13200"
# Leave empty to auto-detect
AUTOPCR_PUBLIC_ADDRESS=

# Use HTTPS for public access links (true/false)
AUTOPCR_USE_HTTPS=false

# ---- OpenBao ----

# By default Docker Compose starts a local OpenBao service.
# Point this to your OpenBao API when using an externally managed instance.
AUTOPCR_OPENBAO_ADDR=http://openbao:8200
AUTOPCR_OPENBAO_AUTH_METHOD=approle
# Only needed when selecting basic static-token authentication.
AUTOPCR_OPENBAO_TOKEN_FILE=/run/openbao/app-token
AUTOPCR_OPENBAO_ROLE_ID=
AUTOPCR_OPENBAO_ROLE_ID_FILE=/run/openbao/role-id
AUTOPCR_OPENBAO_SECRET_ID_FILE=/run/openbao/secret-id
AUTOPCR_OPENBAO_APPROLE_MOUNT=approle

# Used only with manual-bootstrap. Contains app-token or AppRole credentials.
AUTOPCR_OPENBAO_AUTH_DIR=./secrets/openbao

# ---- Docker Settings ----

# Host port to map (change if 13200 is occupied)
HOST_PORT=13200

# Container timezone
TZ=Asia/Shanghai

# Restart policy: no | always | on-failure | unless-stopped
RESTART_POLICY=unless-stopped
